{
  "name": "@datav/react-ts",
  "version": "2.0.0",
  "description": "React 19 TypeScript large-screen visualization components (DataV-React fork)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeungxh1/datav-react-ts.git"
  },
  "bugs": {
    "url": "https://github.com/yeungxh1/datav-react-ts/issues"
  },
  "homepage": "https://github.com/yeungxh1/datav-react-ts#readme",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
